{{page-title "Achievements"}}
<h1>Achievements</h1>
<a name="top"></a>
<ul class="nav nav-tabs" role="tablist">
    {{#each this.model.section_names as |section|}}
      <li class="nav-item cheevo"><a data-bs-toggle="tab" class="nav-link {{get this.model.activity section}}" href="#{{section}}">{{section}}</a></li>
    {{/each}}  
    {{#if this.model.hidden}}
      <li class="nav-item cheevo"><a data-bs-toggle="tab" class="nav-link {{get this.model.activity 'hidden'}}" href="#hidden">Hidden</a></li>
    {{/if}}
</ul>
<div class="tab-content">
    {{#each this.model.section_names as |section|}}
        <AchievementTab @section="{{section}}" @data={{this.model.sections}} @activity={{get this.model.activity section}}/>
    {{/each}}
    {{#if this.model.hidden}}
        <AchievementTab @section="hidden" @data={{this.model.hidden}} @activity={{get this.model.activity 'hidden'}}/>
    {{/if}}
</div>
<div class="action-buttons">
  <a href="#top"><i class="fas fa-chevron-circle-up"></i> Jump to Top</a>
</div>
