{{page-title this.pageTitle}}


<h1>Scene {{this.model.scene.id}}
    {{#if this.model.scene.title}}
     - {{this.model.scene.title}}
     {{/if}}
 </h1>

<div class="row">
    <div class="col col-xs-12">
      <LiveSceneControl @scene={{this.model.scene}} @locations={{this.model.locations}} @abilities={{this.model.abilities}} @abilityList={{this.model.alts.abilityList}} @luckList= {{this.model.alts.luckList}} @places={{this.model.scene.places}} @playerName={{this.currentUser.name}} @characters={{this.model.characters}} @scrollPaused={{this.scrollPaused}} @custom={{this.model.custom}} @refresh={{this.refresh}} @onScrollDown={{this.scrollScene}} @onSetScroll={{this.setScroll}} />
   </div>
</div>
{{outlet}}
