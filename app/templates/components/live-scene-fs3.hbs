<li><a href="#" {{action (mut this.selectSkillRoll) true}} class="dropdown-item">Roll Ability</a></li>
<li><a href="#" {{action (mut this.selectSpendLuck) true}} class="dropdown-item">Spend Luck</a></li>

{{#if this.scene.fs3combat_enabled}}
  {{#if (not this.scene.combat)}}
    <li><a href="#" {{action 'startCombat'}} class="dropdown-item">Start Combat</a></li>
  {{/if}}
{{/if}}

<BsModalSimple @title="Spend Luck" @closeTitle="Cancel" @submitTitle="Spend" @size={{null}} @fade={{true}} @open={{this.selectSpendLuck}} @onSubmit={{action "spendLuck"}} @onHide={{action (mut this.selectSpendLuck) false}}>
  <div class="luck-spender">
  <b>Current Luck Points:</b> <span class={{if this.luckPoints "greenlight" "redlight"}}>{{this.luckPoints}}</span><br/>
  <b>Reason:</b> <Input @type="text" size={{25}} id="luckReason" @enter={{action "spendLuck"}} @value={{this.luckReason}} />
  <b>Amount:</b> <Input @type="number" min="1" id="luckAmount" @enter={{action "spendLuck"}} @value={{this.luckAmount}} style="width: 8ch;" />
  </div>
  
  <h5>Luck Costs</h5>
  <table class="table luck-costs">
    <tbody>
      <tr>
        <td>Push Yourself</td>
        <td>2 luck</td>
        <td>+2 Dice, or act while Incapacitated.<br/>(Can be bought once a roll for each effect.)</td>
      </tr>
      <tr>
        <td>Assist</td>
        <td>1 luck</td>
        <td>Give another character +2 dice.<br/>Possibly take a consequence with them.</td>
      </tr>
      <tr>
        <td>Do-over</td>
        <td>3 luck</td>
        <td>One re-roll on a skill. Re-rolls cannot be pushed or assisted.</td>
      </tr>
      <tr>
        <td>Lead a Group Action</td>
        <td>1 luck per complication avoided</td>
        <td>Make a Group Roll for a skill; best result is the group's success.</td>
      </tr>
    </tbody>
  </table>
</BsModalSimple>

<Fs3Roll @scene={{this.scene}} @destinationType="scene" @abilities={{this.abilities}} @abilityList={{this.abilityList}} @selectSkillRoll={{this.selectSkillRoll}} />
